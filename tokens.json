{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Tribuvex",
  "version": "1.0.0",
  "description": "Three-layer tokens: primitive → semantic → component. Source CSS: tokens.css",
  "primitive": {
    "color": {
      "navy": {
        "50": "#F8FAFC",
        "100": "#E9EEF5",
        "200": "#C5D4E8",
        "400": "#7A9CC0",
        "600": "#2F5F8F",
        "700": "#254A73",
        "800": "#1E3A5F",
        "900": "#0F172A",
        "950": "#0B1220"
      },
      "blue": { "100": "#DBEAFE", "400": "#60A5FA", "500": "#3B82F6", "600": "#2563EB" },
      "green": { "100": "#DCFCE7", "500": "#22C55E", "600": "#16A34A", "700": "#15803D" },
      "amber": { "100": "#FFEDD5", "400": "#FBBF24", "500": "#F59E0B", "600": "#D97706", "700": "#B45309" },
      "red": { "100": "#FEE2E2", "400": "#F87171", "600": "#DC2626", "700": "#B91C1C" },
      "slate": {
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "600": "#475569",
        "700": "#334155",
        "900": "#0F172A"
      },
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px"
    },
    "font": {
      "sans": "IBM Plex Sans, system-ui, sans-serif",
      "mono": "IBM Plex Mono, ui-monospace, monospace"
    },
    "text": {
      "label": "12px",
      "body": "14px",
      "emphasis": "16px",
      "section": "18px",
      "page": "24px"
    },
    "radius": { "sm": "6px", "md": "8px", "lg": "12px", "full": "9999px" },
    "duration": { "fast": "150ms", "base": "200ms", "slow": "250ms" },
    "zIndex": { "sticky": 30, "dropdown": 40, "overlay": 50, "modal": 60, "toast": 70 }
  },
  "semantic": {
    "light": {
      "primary": "{primitive.color.navy.800}",
      "onPrimary": "{primitive.color.white}",
      "secondary": "{primitive.color.blue.600}",
      "accent": "{primitive.color.green.600}",
      "warning": "{primitive.color.amber.600}",
      "destructive": "{primitive.color.red.600}",
      "background": "{primitive.color.navy.50}",
      "foreground": "{primitive.color.slate.900}",
      "card": "{primitive.color.white}",
      "muted": "{primitive.color.navy.100}",
      "mutedForeground": "{primitive.color.slate.600}",
      "border": "{primitive.color.slate.300}",
      "ring": "{primitive.color.navy.800}"
    },
    "dark": {
      "primary": "{primitive.color.navy.400}",
      "onPrimary": "{primitive.color.navy.950}",
      "secondary": "{primitive.color.blue.400}",
      "accent": "{primitive.color.green.500}",
      "warning": "{primitive.color.amber.500}",
      "destructive": "{primitive.color.red.400}",
      "background": "#0B1220",
      "foreground": "#E2E8F0",
      "card": "#121A2B",
      "muted": "#1A2438",
      "mutedForeground": "#94A3B8",
      "border": "#2A3548",
      "ring": "{primitive.color.navy.400}"
    }
  },
  "component": {
    "button": {
      "primary": { "bg": "{semantic.accent}", "fg": "{semantic.onAccent}" },
      "secondary": { "bg": "transparent", "fg": "{semantic.primary}", "border": "{semantic.primary}" },
      "info": { "bg": "{semantic.secondary}", "fg": "{semantic.onSecondary}" },
      "destructive": { "bg": "{semantic.destructive}", "fg": "{semantic.onDestructive}" },
      "radius": "{primitive.radius.sm}",
      "padding": { "y": "{primitive.space.2}", "x": "{primitive.space.4}" }
    },
    "badge": {
      "success": { "bg": "{primitive.color.green.100}", "fg": "{primitive.color.green.700}" },
      "warning": { "bg": "{primitive.color.amber.100}", "fg": "{primitive.color.amber.700}" },
      "danger": { "bg": "{primitive.color.red.100}", "fg": "{primitive.color.red.700}" },
      "info": { "bg": "{primitive.color.blue.100}", "fg": "#1E40AF" }
    },
    "field": {
      "radius": "{primitive.radius.sm}",
      "border": "{semantic.input}",
      "focusRing": "color-mix ring 20%"
    },
    "card": {
      "bg": "{semantic.card}",
      "border": "{semantic.border}",
      "radius": "{primitive.radius.md}",
      "padding": "{primitive.space.6}"
    }
  },
  "tailwind": {
    "import": "@import \"./tokens.css\";",
    "utilities": [
      "bg-primary",
      "text-primary",
      "bg-accent",
      "bg-secondary",
      "bg-destructive",
      "bg-warning",
      "bg-background",
      "text-foreground",
      "bg-card",
      "text-muted-foreground",
      "border-border",
      "ring-ring",
      "font-sans",
      "font-mono",
      "rounded-sm",
      "rounded-md",
      "shadow-sm"
    ],
    "darkMode": "class dark on html"
  }
}
